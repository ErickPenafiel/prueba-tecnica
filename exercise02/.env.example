# ============================================
# n8n Configuration
# ============================================

# Host y puerto donde correrá n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# URL pública (si estás en local, deja localhost)
WEBHOOK_URL=http://localhost:5678/

# Zona horaria
GENERIC_TIMEZONE=America/La_Paz

# Auth básica para proteger la UI de n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia_esta_contraseña_AHORA

# ============================================
# SafeBank AI API (Ejercicio 01) Configuration
# ============================================

# Host del API del Ejercicio 01 (usar host.docker.internal para conectarse desde Docker)
FASTAPI_HOST=host.docker.internal
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://host.docker.internal:8000

# Endpoints disponibles:
# GET ${FASTAPI_BASE_URL}/api/v1/risk-analysis?company_name=Tesla
# GET ${FASTAPI_BASE_URL}/health

# ============================================
# Google Workspace (Opcional - para workflows)
# ============================================

# IDs de recursos de Google (obtener después de crear)
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_FOLDER_ID=

# ============================================
# IMPORTANTE: Antes de usar n8n
# ============================================
# 1. Asegúrate de que el API del Ejercicio 01 está corriendo:
#    cd ../exercise01
#    uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
#
# 2. Cambia N8N_BASIC_AUTH_PASSWORD por una contraseña segura
#
# 3. Levanta n8n con: docker-compose up -d
#
# 4. Accede a: http://localhost:5678

